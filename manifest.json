{
  "manifest_version": 3,
  "name": "Research Tool",
  "version": "4.12",
  "description": "Translates, summarizes and fact-checks the tweets behind memecoins on Axiom and GMGN.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.mymemory.translated.net/*",
    "https://api.fxtwitter.com/*",
    "https://news.google.com/*",
    "https://api.github.com/*",
    "https://www.reddit.com/*",
    "https://www.tikwm.com/*",
    "https://www.tiktok.com/*",
    "https://www.bing.com/*",
    "https://html.duckduckgo.com/*",
    "https://api.anthropic.com/*"
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Research Tool",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://axiom.trade/*",
        "https://*.axiom.trade/*",
        "https://gmgn.ai/*",
        "https://*.gmgn.ai/*"
      ],
      "js": [
        "idiomas.js",
        "termos.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://axiom.trade/*",
        "https://*.axiom.trade/*"
      ],
      "js": [
        "pagina.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}